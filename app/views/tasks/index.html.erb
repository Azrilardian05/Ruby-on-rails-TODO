<% content_for :title, "Tasks | Todo App" %>

<div class="page-header">
  <h1>Tasks</h1>
  <%= link_to "New task", new_task_path, class: "btn" %>
</div>

<% if @tasks.empty? %>
  <p class="empty-state">No tasks yet. Create your first one!</p>
<% else %>
  <ul id="tasks" class="task-list">
    <% @tasks.each do |task| %>
      <li id="<%= dom_id(task) %>" class="task <%= "is-completed" if task.completed? %>">
        <div>
          <%= link_to task.title, task, class: "task-title" %>
          <div class="task-meta">
            <% if task.completed? %>
              <span class="badge badge-done">Done</span>
            <% else %>
              <span class="badge">Pending</span>
            <% end %>
            <% if task.due_date %>
              <span>Due <%= l(task.due_date) %></span>
            <% end %>
          </div>
        </div>

        <div class="task-actions">
          <%= link_to "Edit", edit_task_path(task), class: "btn btn-secondary btn-small" %>
          <%= button_to "Delete", task, method: :delete, class: "btn btn-danger btn-small",
                form: { data: { turbo_confirm: "Are you sure?" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
