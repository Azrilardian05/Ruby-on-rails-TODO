<h1>Tasks</h1>

<p><%= link_to "New task", new_task_path %></p>

<% if @tasks.empty? %>
  <p>No tasks yet.</p>
<% else %>
  <ul id="tasks">
    <% @tasks.each do |task| %>
      <li id="<%= dom_id(task) %>">
        <%= link_to task.title, task %>
        <%= "(done)" if task.completed? %>
        <%= "due #{l(task.due_date)}" if task.due_date %>
        | <%= link_to "Edit", edit_task_path(task) %>
        | <%= button_to "Delete", task, method: :delete, form: { style: "display:inline", data: { turbo_confirm: "Are you sure?" } } %>
      </li>
    <% end %>
  </ul>
<% end %>
