<% content_for :title, "Tasks | Todo App" %>

<div class="page-header">
  <h1>Tasks</h1>
  <%= link_to "New task", new_task_path, class: "btn" %>
</div>

<div class="task-controls">
  <nav class="filter-tabs" aria-label="Filter tasks">
    <% { "all" => "All", "active" => "Active", "completed" => "Completed" }.each do |status, label| %>
      <%= link_to label, tasks_path(status: status, sort: @sort, direction: @direction),
            class: "filter-tab #{"is-current" if @status == status}",
            aria: { current: (@status == status ? "page" : nil) } %>
    <% end %>
  </nav>

  <%= form_with url: tasks_path, method: :get, class: "sort-form" do |f| %>
    <%= hidden_field_tag :status, @status, id: nil %>
    <%= f.label :sort, "Sort by" %>
    <%= f.select :sort, [ [ "Date created", "created_at" ], [ "Due date", "due_date" ] ], { selected: @sort }, onchange: "this.form.requestSubmit()" %>
    <%= f.select :direction, [ [ "Ascending", "asc" ], [ "Descending", "desc" ] ], { selected: @direction }, { "aria-label": "Direction", onchange: "this.form.requestSubmit()" } %>
    <noscript><%= f.submit "Apply", class: "btn btn-secondary btn-small" %></noscript>
  <% end %>
</div>

<% if @tasks.empty? %>
  <p class="empty-state">
    <% if @status == "all" %>
      No tasks yet. Create your first one!
    <% else %>
      No <%= @status %> tasks.
    <% end %>
  </p>
<% else %>
  <ul id="tasks" class="task-list">
    <% @tasks.each do |task| %>
      <li id="<%= dom_id(task) %>" class="task <%= "is-completed" if task.completed? %>">
        <div class="task-main">
          <%= button_to toggle_task_path(task), method: :patch, class: "task-toggle",
                form_class: "task-toggle-form",
                title: (task.completed? ? "Mark as pending" : "Mark as done"),
                aria: { label: (task.completed? ? "Mark \"#{task.title}\" as pending" : "Mark \"#{task.title}\" as done"), pressed: task.completed? } do %>
            <%= task.completed? ? "✓" : "" %>
          <% end %>
          <div>
          <%= link_to task.title, task, class: "task-title" %>
          <div class="task-meta">
            <% if task.completed? %>
              <span class="badge badge-done">Done</span>
            <% else %>
              <span class="badge">Pending</span>
            <% end %>
            <% if task.due_date %>
              <span>Due <%= l(task.due_date) %></span>
            <% end %>
          </div>
          </div>
        </div>

        <div class="task-actions">
          <%= link_to "Edit", edit_task_path(task), class: "btn btn-secondary btn-small" %>
          <%= button_to "Delete", task, method: :delete, class: "btn btn-danger btn-small",
                form: { data: { turbo_confirm: "Are you sure?" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
