<%= form_with model: task do |form| %>
  <% if task.errors.any? %>
    <div id="error_explanation" class="error-summary" role="alert">
      <h2><%= pluralize(task.errors.count, "error") %> prevented this task from being saved:</h2>
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :title %>
    <%= form.text_field :title, autofocus: task.new_record? %>
  </div>

  <div class="form-field">
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div class="form-field">
    <%= form.label :due_date %>
    <%= form.date_field :due_date %>
  </div>

  <div class="form-field form-field-inline">
    <%= form.check_box :completed %>
    <%= form.label :completed %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancel", tasks_path %>
  </div>
<% end %>
